# Copy to .env (which is gitignored). Filled values are fed to:
#  - servers/browser/run.sh via Playwright MCP --secrets flag
#  - servers/computer container via docker compose
# 不要把真实密码 / TOTP secret 放这里 —— 那些进 1Password。
# 这里只放低敏感的运行时变量。

# Disable mobile-mcp telemetry
MOBILEMCP_DISABLE_TELEMETRY=1

# Computer-use container (Phase 4)
# ANTHROPIC_API_KEY=  # 仅当你想跑容器内 Streamlit demo 时需要；MCP wrapper 不需要

# Browser default landing page (optional)
# BROWSER_HOMEPAGE=https://www.google.com
